# IATI samples are normally local. Keep only the intentional CAF source
# snapshot and its two summary exports under version control.
data-samples/*
!data-samples/caf/
data-samples/caf/*
!data-samples/caf/CAF-ActivityFile.xml
!data-samples/caf/list_activities.csv
!data-samples/caf/org.csv

# Generated caches and local profiles must not be committed.
data-samples/caf/cache/
deploy/*.env
!deploy/*.env.example

.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
dist/
*.egg-info/
CLAUDE.md
