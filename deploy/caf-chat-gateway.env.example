# Environment for the separate CAF chat gateway process. Copy this file outside
# Git, set the AI provider values, and source it before starting the sibling
# mcp-chat-gateway repository.

# URL of the CAF-specific mcp-server process.
MCP_URL=http://127.0.0.1:8063/

# Set these according to the selected OpenAI-compatible provider.
AI_BASE_URL=https://api.example.com/v1
AI_API_KEY=replace-with-a-secret-managed-outside-git
AI_MODEL=replace-with-your-model-name

# Gateway HTTP settings. Use a distinct port when the generic gateway runs too.
WEBCHAT_HOST=127.0.0.1
WEBCHAT_PORT=8065

# Optional label shown by the gateway in its scoped system context.
DATASET_SCOPE="CAF IATI activities and transactions"