# Environment for the separate MCP server process that serves CAF's local
# IATI XML. Copy this file outside Git, fill in the XML path, and source it
# before starting mcp-server from the sibling mcp-server repository.

# The local XML always takes precedence over remote IATI sources.
MCP_IATI_XML_PATH=/absolute/path/to/mcp-iati/data-samples/caf/CAF-ActivityFile.xml

# Identifies the publisher for CAF-specific plugin content. The local XML
# above remains the selected data source.
MCP_IATI_DATASET=caf-actfile-46008-2603

# CAF gets its own converted-CSV cache; it must not be shared with another
# IATI deployment.
MCP_IATI_DATA_DIR=/absolute/path/to/mcp-iati/data-samples/caf/cache

# mcp-server HTTP settings. Keep its normal port unless another process uses it.
MCP_TRANSPORT=http
MCP_HOST=127.0.0.1
MCP_PORT=8063